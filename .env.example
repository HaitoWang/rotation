# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8765
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://regert:regert@postgres:5432/regert
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=regert
REDIS_EVENT_CHANNEL_PREFIX=regert:events
REGERT_DATA_DIR=backend/data

# Async side-effect worker
TEAM_SSO_ENABLED=false
TEAM_SSO_URL=
TEAM_SSO_SYNC_KEY=
TEAM_SSO_TIMEOUT=10
TEAM_ROTATION_ENABLED=false
TEAM_ROTATION_PROXY=
